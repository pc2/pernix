prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

name: Pernix
description: A high-performance C++ library for de/compression of floating-point data
version: @NORMALIZED_VERSION@
Requires: @PERNIX_PC_REQUIRES@

Libs: -L${libdir} -lpernix
Cflags: -I${includedir}
